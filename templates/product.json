{
  "sections": {
    "fm_product": {
      "type": "fm-main-product",
      "blocks": {
        "care": {
          "type": "care",
          "settings": {
            "heading": "Product Care",
            "fabric_label": "Fabric",
            "fabric_text": "Mix fabric. Handle with care while cleaning.",
            "care_label": "Care",
            "care_list": "Dry clean only\nCan be ironed on low heat\nDo not use bleach"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "show_stock": true,
            "in_stock_text": "In Stock",
            "show_sku": true
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "label": "Price",
            "note": "Shipping calculated at checkout."
          }
        },
        "shipping": {
          "type": "info_row",
          "settings": {
            "label": "Shipping time",
            "value": "7-10 business days"
          }
        },
        "variants": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle",
            "size_label": "Size",
            "size_chart_text": "Size chart",
            "size_chart_url": ""
          }
        },
        "quantity": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy": {
          "type": "buy_buttons",
          "settings": {
            "show_wishlist": true,
            "wishlist_text": "Add to wishlist",
            "wishlist_url": "",
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "label": "Description",
            "open_by_default": false
          }
        },
        "size_chart": {
          "type": "size_chart",
          "settings": {
            "link_text": "Size Chart",
            "metafield_namespace": "custom",
            "metafield_key": "size_chart",
            "image_metafield_key": "size_chart_image",
            "heading": "",
            "subheading": "Size Charts",
            "note": "<p><strong>Note:</strong> All measurements are in inches and refer to the finished garment (merchandise) size.</p>",
            "content": "",
            "show_gallery": true,
            "autorotate_speed": 4
          }
        },
        "custom_order": {
          "type": "custom_order",
          "settings": {
            "toggle_text": "Custom Order",
            "intro": "Not finding your size? Give us your measurements in inches and we will make it to order.",
            "fields": "Shoulder\nSleeve length\nBust\nBottom length\nWaist\nCalf\nHip\nThighs\nTop length\nAnkle",
            "show_notes": true,
            "notes_label": "Notes",
            "availability": "all",
            "metafield_namespace": "custom",
            "enabled_metafield_key": "custom_order_enabled",
            "fields_metafield_key": "",
            "submit_mode": "auto",
            "variant_name": "Custom Order",
            "add_label": "Add custom order to cart",
            "name_label": "Your name",
            "email_label": "Your email",
            "submit_text": "Send custom order request",
            "success_text": "Thank you — we have your measurements and will be in touch shortly."
          }
        }
      },
      "block_order": [
        "care",
        "title",
        "price",
        "shipping",
        "size_chart",
        "variants",
        "custom_order",
        "quantity",
        "buy",
        "description"
      ],
      "settings": {
        "show_breadcrumbs": true,
        "image_fit": "cover",
        "padding_top": 12,
        "padding_bottom": 24
      }
    },
    "fm_similar": {
      "type": "fm-product-rail",
      "settings": {
        "title": "Similar Products",
        "source": "product_collection",
        "intent": "related",
        "collection": "bestsellers",
        "products_to_show": 5,
        "image_ratio": "portrait",
        "image_fit": "contain",
        "show_vendor": false,
        "show_secondary_image": true,
        "new_badge_label": "New",
        "background": "#ffffff",
        "padding_top": 28,
        "padding_bottom": 28,
        "fallback_to_collection": true
      }
    }
  },
  "order": [
    "fm_product",
    "fm_similar"
  ]
}

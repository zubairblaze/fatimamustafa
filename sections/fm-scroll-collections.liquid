{{ 'fm-scroll-row.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fm-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols_desktop = section.settings.columns_desktop | default: 6
  assign cols_mobile = section.settings.columns_mobile | default: 2
  assign gaps_desktop = cols_desktop | minus: 1
  assign gaps_mobile = cols_mobile | minus: 1

  assign desktop_vw = 100 | divided_by: cols_desktop | append: 'vw'
  assign mobile_vw = 100 | divided_by: cols_mobile | append: 'vw'
  assign tile_sizes = '(min-width: 750px) ' | append: desktop_vw | append: ', ' | append: mobile_vw
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .fm-scroll-row__item {
    /* Show exactly the requested number of tiles, with a sliver of the next. */
    width: calc((100% - {{ gaps_mobile }} * var(--fm-gutter)) / {{ cols_mobile }} - var(--fm-peek));
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .fm-scroll-row__item {
      width: calc((100% - {{ gaps_desktop }} * var(--fm-gutter)) / {{ cols_desktop }} - var(--fm-peek));
    }
  }

  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
    background-color: {{ section.settings.background }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="fm-scroll-row fm-scroll-row--{{ section.settings.image_ratio }} fm-fit-{{ section.settings.image_fit | default: 'cover' }}">
  <fm-scroller>
    {%- if section.settings.title != blank or section.settings.subtitle != blank or section.settings.show_arrows -%}
      <div class="fm-head">
        <div class="fm-head__text">
          {%- if section.settings.title != blank -%}
            <h2 class="fm-head__title">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <p class="fm-head__subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_arrows -%}
          <div class="fm-head__aside">
            <div class="fm-arrows">
              <button type="button" class="fm-arrow fm-arrow--prev" data-fm-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
                {% render 'fm-arrow-icon' %}
              </button>
              <button type="button" class="fm-arrow fm-arrow--next" data-fm-next aria-label="{{ 'general.slider.next_slide' | t }}">
                {% render 'fm-arrow-icon' %}
              </button>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="fm-scroller fm-scroll-row__track" data-fm-track role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign label = block.settings.label
          if label == blank
            assign label = collection.title
          endif

          assign image = block.settings.image
          if image == blank
            assign image = collection.featured_image
          endif

          assign url = block.settings.link
          if url == blank and collection != blank
            assign url = collection.url
          endif

          assign alt_text = image.alt | default: label | escape        -%}
        <li class="fm-scroll-row__item" {{ block.shopify_attributes }}>
          <a
            href="{{ url | default: routes.all_products_collection_url }}"
            class="fm-tile fm-scroll-row__tile fm-ratio fm-scroll-row__frame"
          >
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 900
                | image_tag:
                  class: 'fm-tile__media',
                  loading: 'lazy',
                  widths: '200, 300, 400, 600, 900',
                  sizes: tile_sizes,
                  alt: alt_text
              }}
            {%- else -%}
              {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              <div class="fm-tile__placeholder">
                {{ 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            <span class="fm-tile__scrim"></span>
            {%- if label != blank -%}
              <span class="fm-tile__label">{{ label }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </fm-scroller>
</div>

{% schema %}
{
  "name": "FM Scroll Row",
  "tag": "section",
  "class": "fm-scroll-collections",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Shop the latest arrivals across every category"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Collections shown on desktop",
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Collections shown on mobile",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "tall",
          "label": "Tall"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover (fill and crop)"
        },
        {
          "value": "contain",
          "label": "Contain (fit whole image)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the collection image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Falls back to the collection title."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Falls back to the collection URL."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Scroll Row",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}

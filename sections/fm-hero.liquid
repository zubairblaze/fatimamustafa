{{ 'fm-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fm-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heights = 'small:52svh,medium:66svh,large:78svh,full:100svh' | split: ','
  assign height_value = '66svh'
  for pair in heights
    assign parts = pair | split: ':'
    if parts[0] == section.settings.height
      assign height_value = parts[1]
    endif
  endfor

  comment
    Below the header, the hero fills what is left of the screen rather than a
    whole screen of its own, so the page does not start already scrolled. The
    offset is measured by the script at the end of this section, because the
    header only publishes its own height when it is set to stick.
  endcomment
  if section.settings.height == 'full_below_header'
    assign height_value = 'calc(100svh - var(--fm-hero-offset, 0px))'
  endif
-%}

{%- style -%}
  #fm-hero-{{ section.id }} {
    height: {{ height_value }};
    min-height: 34rem;
  }

  @media screen and (max-width: 749px) {
    #fm-hero-{{ section.id }} {
      height: {{ section.settings.height_mobile }}vh;
      min-height: 30rem;
    }
  }
{%- endstyle -%}

<fm-hero
  id="fm-hero-{{ section.id }}"
  class="fm-hero fm-fit-{{ section.settings.image_fit | default: 'cover' }}"
  data-interval="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed | times: 1000 }}{% else %}0{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign has_link = false
      if block.settings.link != blank
        assign has_link = true
      endif

      assign loading = 'lazy'
      assign priority = 'auto'
      if forloop.first
        assign loading = 'eager'
        assign priority = 'high'
      endif

      assign alt_desktop = block.settings.image.alt | default: block.settings.heading | escape
      assign mobile_image = block.settings.image_mobile | default: block.settings.image
      assign alt_mobile = mobile_image.alt | default: block.settings.heading | escape

      comment
        Cover has to crop something whenever the image and the screen are not
        the same shape, and on a wide screen it takes that out of the top and
        bottom - which is how a model loses her head. The focal point set on
        the image in the admin decides what stays, so the crop keeps the face
        rather than the middle.
      endcomment
      assign focal_desktop = block.settings.image.presentation.focal_point
      assign focal_mobile = mobile_image.presentation.focal_point

      comment
        Carried as custom properties on the slide rather than as a style
        attribute on the image, so this does not rest on image_tag passing an
        arbitrary attribute through. The css falls back to dead centre.
      endcomment
      assign focal_style = ''
      if focal_desktop != blank
        assign focal_style = focal_style | append: '--fm-focal-desktop: ' | append: focal_desktop | append: ';'
      endif
      if focal_mobile != blank
        assign focal_style = focal_style | append: '--fm-focal-mobile: ' | append: focal_mobile | append: ';'
      endif
    -%}
    <div
      class="fm-hero__slide"
      data-fm-slide
      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
      {% if focal_style != blank %}style="{{ focal_style }}"{% endif %}
      {{ block.shopify_attributes }}
    >
      {%- if has_link -%}<a class="fm-hero__link" href="{{ block.settings.link }}">{%- endif -%}

      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 3000
          | image_tag:
            class: 'fm-hero__media fm-hero__media--desktop',
            loading: loading,
            fetchpriority: priority,
            widths: '750, 1100, 1500, 1780, 2000, 3000',
            sizes: '100vw',
            alt: alt_desktop
        }}
      {%- else -%}
        <div class="fm-hero__placeholder fm-hero__media--desktop">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}

      {%- if mobile_image != blank -%}
        {{
          mobile_image
          | image_url: width: 1200
          | image_tag:
            class: 'fm-hero__media fm-hero__media--mobile',
            loading: loading,
            widths: '450, 660, 900, 1200',
            sizes: '100vw',
            alt: alt_mobile
        }}
      {%- else -%}
        <div class="fm-hero__placeholder fm-hero__media--mobile">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}

      {%- if block.settings.overlay_opacity > 0 -%}
        <div class="fm-hero__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
      {%- endif -%}

      {%- if block.settings.heading != blank
        or block.settings.subheading != blank
        or block.settings.button_label != blank
      -%}
        <div
          class="fm-hero__content fm-hero__content--{{ block.settings.position_vertical }} fm-hero__content--{{ block.settings.position_horizontal }}"
          style="color: {{ block.settings.text_color }};"
        >
          <div class="fm-hero__inner">
            {%- if block.settings.heading != blank -%}
              <p class="fm-hero__heading">{{ block.settings.heading }}</p>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="fm-hero__subheading">{{ block.settings.subheading }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and has_link == false -%}
              <a class="fm-hero__cta" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                <span>{{ block.settings.button_label }}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if has_link -%}</a>{%- endif -%}
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="fm-hero__dots">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="fm-hero__dot"
          data-fm-dot
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          <span class="fm-visually-hidden">
            {{ 'sections.slideshow.load_slide' | t: slide_number: forloop.index }}
          </span>
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</fm-hero>

{%- if section.settings.height == 'full_below_header' -%}
  <script>
    (function () {
      var hero = document.getElementById('fm-hero-{{ section.id }}');
      if (!hero) return;

      // Whatever sits above the hero - announcement bar, header, nav row - is
      // what the hero has to give back. Measuring it beats reading the
      // header's own variable, which only exists when the header is sticky.
      var apply = function () {
        var above = hero.getBoundingClientRect().top + window.pageYOffset;
        if (above < 0) above = 0;
        hero.style.setProperty('--fm-hero-offset', above + 'px');
      };

      // Measured before paint, then again once webfonts and images have
      // settled, since either can change the header's height.
      apply();
      window.addEventListener('load', apply);
      window.addEventListener('resize', apply);
      if ('ResizeObserver' in window && hero.previousElementSibling) {
        new ResizeObserver(apply).observe(document.body);
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FM Hero",
  "tag": "section",
  "class": "fm-hero-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Desktop height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        },
        {
          "value": "full_below_header",
          "label": "Full screen below header"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 70
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover (fill and crop)"
        },
        {
          "value": "contain",
          "label": "Contain (fit whole image)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds between slides",
      "default": 6
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Screen reader label",
      "default": "Featured collections"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Falls back to the desktop image."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "VELVET"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Luxury Formals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link",
          "info": "Makes the whole slide clickable and hides the button."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Image darkening",
          "default": 10
        },
        {
          "type": "select",
          "id": "position_vertical",
          "label": "Vertical position",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "middle",
              "label": "Middle"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ],
          "default": "bottom"
        },
        {
          "type": "select",
          "id": "position_horizontal",
          "label": "Horizontal position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Hero",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}

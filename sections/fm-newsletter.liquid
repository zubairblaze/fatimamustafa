{{ 'fm-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
    background-color: {{ section.settings.background }};
    border-top: 1px solid rgb(var(--fm-rule));
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="fm-section">
  <div class="fm-newsletter">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="fm-newsletter__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="fm-newsletter__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="fm-newsletter__col">
      {%- assign form_id = 'fm-newsletter-' | append: section.id -%}
      {%- form 'customer', id: form_id, class: 'fm-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="fm-visually-hidden" for="fm-newsletter-email-{{ section.id }}">
          {{ 'newsletter.label' | t }}
        </label>
        <input
          id="fm-newsletter-email-{{ section.id }}"
          class="fm-newsletter__field"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ section.settings.placeholder | escape }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="fm-newsletter-error-{{ section.id }}"
          {% endif %}
        >
        <button type="submit" class="fm-newsletter__button" name="commit">
          {{ section.settings.button_label }}
        </button>

        {%- comment -%} `form` is only in scope inside this tag. {%- endcomment -%}
        {%- if form.errors -%}
          <p
            class="fm-newsletter__message fm-newsletter__message--error"
            id="fm-newsletter-error-{{ section.id }}"
          >
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="fm-newsletter__message fm-newsletter__message--success">
            {{ 'newsletter.success' | t }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FM Newsletter",
  "tag": "section",
  "class": "fm-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our newsletter"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "New arrivals, private sales and styling notes."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "FM Newsletter"
    }
  ]
}
{% endschema %}

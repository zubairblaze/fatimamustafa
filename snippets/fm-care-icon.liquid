{%- comment -%}
  Renders one care icon.

  Three sources, in order: an uploaded file wins, then a name, then a tick.
  A name is either one of the built-in icons below or a Font Awesome class
  list such as "fa-solid fa-droplet" - anything containing "fa-" is handed
  to Font Awesome, which the care block loads only when it is given a
  stylesheet URL.

  Any built-in name can be prefixed "no-" to draw the same icon struck
  through, so "no-water" and "no-iron" need no artwork of their own.

  Accepts:
  - name: {String} built-in icon name or Font Awesome class list (optional)
  - image: {Object} uploaded file, wins over name (optional)

  Usage:
  {% render 'fm-care-icon', name: icon_name, image: icon_file %}
{%- endcomment -%}

{%- liquid
  assign key = name | strip | downcase
  assign is_fa = false
  if key contains 'fa-'
    assign is_fa = true
  endif

  assign slashed = false
  assign head = key | slice: 0, 3
  if head == 'no-'
    assign slashed = true
    assign key = key | remove_first: 'no-'
  endif
-%}

{%- if image.width > 0 -%}
  {{ image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '36, 72, 96', alt: '' }}

{%- elsif image.url != blank -%}
  <img src="{{ image.url }}" alt="" loading="lazy" width="36" height="36">

{%- elsif is_fa -%}
  <i class="{{ name | strip | escape }}" aria-hidden="true"></i>

{%- else -%}
  <svg
    class="fm-care__glyph"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {%- case key -%}
      {%- when 'water' -%}
        <path d="M12 3.5c3.2 3.6 5.5 6.4 5.5 9.2a5.5 5.5 0 0 1-11 0c0-2.8 2.3-5.6 5.5-9.2z" />

      {%- when 'bath' -%}
        <path d="M3 12.5h18v2a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z" />
        <path d="M6.5 12.5V6a1.8 1.8 0 0 1 3.6 0" />
        <path d="M6 19.5l-1 1.5" />
        <path d="M18 19.5l1 1.5" />

      {%- when 'box' -%}
        <path d="M3.5 7.5l8.5-4 8.5 4v9l-8.5 4-8.5-4z" />
        <path d="M3.5 7.5l8.5 4 8.5-4" />
        <path d="M12 11.5v9" />

      {%- when 'cloth' -%}
        <path d="M11 3.5l1.7 4.4 4.4 1.7-4.4 1.7L11 15.7 9.3 11.3 4.9 9.6l4.4-1.7z" />
        <circle cx="18" cy="17" r="1.8" />

      {%- when 'iron' -%}
        <path d="M3.5 16.5v-1.8a6 6 0 0 1 6-6h6.8l2.7 7.8z" />
        <path d="M8.5 8.7V7a1.8 1.8 0 0 1 1.8-1.8h5.4" />

      {%- when 'bleach' -%}
        <path d="M12 4l8.5 16h-17z" />

      {%- when 'dry-clean' -%}
        <circle cx="12" cy="12" r="8.5" />
        <path d="M10 16.5v-9h2.6a2.6 2.6 0 0 1 0 5.2H10" />

      {%- when 'hand-wash' -%}
        <path d="M3.5 13.5h17v1.8a4 4 0 0 1-4 4h-9a4 4 0 0 1-4-4z" />
        <path d="M8 10.5V6.2a1.6 1.6 0 0 1 3.2 0v4.3" />
        <path d="M11.2 10.5V5a1.6 1.6 0 0 1 3.2 0v5.5" />

      {%- when 'machine-wash' -%}
        <rect x="4" y="3.5" width="16" height="17" rx="2" />
        <circle cx="12" cy="13.5" r="4" />
        <circle cx="16.6" cy="7" r="0.9" />

      {%- when 'sun' -%}
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2" />
        <path d="M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6" />

      {%- when 'hanger' -%}
        <path d="M12 9.2V8a2.2 2.2 0 1 1 2.8 2.1" />
        <path d="M12 9.2l8.4 6a1.4 1.4 0 0 1-.8 2.6H4.4a1.4 1.4 0 0 1-.8-2.6z" />

      {%- when 'perfume' -%}
        <rect x="7.5" y="9" width="9" height="11.5" rx="1.6" />
        <path d="M10 9V5.5h4V9" />
        <path d="M16.5 7h2.3v2.6" />

      {%- when 'temperature' -%}
        <path d="M14 14.6V6a2 2 0 1 0-4 0v8.6a4 4 0 1 0 4 0z" />

      {%- else -%}
        <polyline points="4.5 12.5 9.5 17.5 19.5 6.5" />
    {%- endcase -%}

    {%- if slashed -%}
      <line x1="4.5" y1="19.5" x2="19.5" y2="4.5" />
    {%- endif -%}
  </svg>
{%- endif -%}

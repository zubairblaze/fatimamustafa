{% comment %}
  Renders the FM header extras: a row of small utility links and a wishlist
  icon. Both are optional and configured on the Header section.
{% endcomment %}

{%- if section.settings.fm_utility_menu != blank -%}
  <nav class="fm-header-utils" aria-label="{{ section.settings.fm_utility_menu.title | escape }}">
    {%- for link in section.settings.fm_utility_menu.links -%}
      <a class="fm-header-utils__link" href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>
{%- endif -%}

{%- if section.settings.fm_show_wishlist -%}
  <a
    href="{{ section.settings.fm_wishlist_url | default: routes.search_url }}"
    class="header__icon header__icon--wishlist link focus-inset"
  >
    <span class="svg-wrapper">{{ 'icon-heart.svg' | inline_asset_content }}</span>
    <span class="visually-hidden">{{ section.settings.fm_wishlist_label | default: 'Wishlist' }}</span>
  </a>
{%- endif -%}
